<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>나의 성격 MBTI 찾기</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Import Map for Google Gen AI SDK -->
  <script type="importmap">
    {
      "imports": {
        "@google/genai": "https://esm.run/@google/genai"
      }
    }
  </script>

  <style>
    html { scroll-behavior: smooth; }
    .animate-fade-in {
      animation: fadeIn 0.5s ease-out forwards;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen py-8 px-4 sm:px-6 lg:px-8">

  <div class="max-w-4xl mx-auto space-y-8">
    
    <!-- Header Section -->
    <header class="text-center space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-indigo-600 tracking-tight">
        나의 성격 MBTI 찾기
      </h1>
      <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto">
        양쪽의 문장을 잘 읽고, 자신에게 더 가까운 문항을 선택해 보세요.<br>
        자신의 "장점"에 집중하여 솔직하게 답변할 때 가장 정확한 결과를 얻을 수 있습니다.[cite: 1]
      </p>
    </header>

    <!-- Gemini API Key Input Card -->
    <section class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
      <div class="flex items-center space-x-2 mb-3">
        <i class="fa-solid fa-key text-indigo-500 text-lg"></i>
        <h2 class="text-lg font-bold text-slate-800">Gemini API 키 설정 (AI 심층 분석용)</h2>
      </div>
      <p class="text-xs text-slate-500 mb-4">
        검사 결과 후 Gemini AI의 맞춤형 심층 분석을 받기 위해 Google AI Studio에서 발급받은 API 키를 입력해 주세요.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <input type="password" id="apiKeyInput" placeholder="Gemini API 키를 입력하세요 (예: AIzaSy...)" 
               class="flex-1 px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
        <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center justify-center px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition-colors">
          키 발급받기 <i class="fa-solid fa-external-link ml-1.5 text-xs"></i>
        </a>
      </div>
    </section>

    <!-- Questions Form Section -->
    <form id="mbtiForm" class="space-y-8">
      <!-- Dynamic Question Cards Container -->
      <div id="questionsContainer" class="space-y-6"></div>

      <!-- Submit Button Section -->
      <div class="text-center pt-4">
        <button type="button" id="analyzeBtn" class="w-full sm:w-auto px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-lg rounded-2xl shadow-lg hover:shadow-indigo-200 transition-all transform hover:-translate-y-0.5">
          <i class="fa-solid fa-wand-magic-sparkles mr-2"></i> 결과 분석하기
        </button>
      </div>
    </form>

    <!-- Loading Indicator -->
    <div id="loadingSpinner" class="hidden text-center py-12 space-y-4">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-indigo-600 border-t-transparent"></div>
      <p id="spinnerText" class="text-indigo-600 font-semibold animate-pulse">Gemini AI가 당신의 MBTI와 성격을 심층 분석하고 있습니다...</p>
    </div>

    <!-- Result Section (Initially Hidden) -->
    <section id="resultSection" class="hidden bg-white p-6 sm:p-8 rounded-3xl shadow-xl border border-indigo-100 space-y-6 animate-fade-in">
      <div class="text-center border-b border-slate-100 pb-6">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-500 bg-indigo-50 px-3 py-1 rounded-full">Test Result</span>
        <h2 class="text-2xl font-bold text-slate-800 mt-2">당신의 MBTI 성격 유형은</h2>
        <div id="mbtiBadge" class="inline-block mt-3 px-6 py-2 bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-3xl sm:text-4xl font-extrabold rounded-2xl shadow-md tracking-wider">
          ----
        </div>
      </div>

      <!-- Basic Analysis (From PDF Data) -->
      <div class="space-y-3">
        <h3 class="text-lg font-bold text-slate-800 flex items-center">
          <i class="fa-solid fa-list-check text-indigo-500 mr-2"></i> 기본 특성 요약
        </h3>
        <div id="basicTraits" class="bg-slate-50 p-4 rounded-xl text-slate-700 text-sm leading-relaxed whitespace-pre-line border border-slate-200">
        </div>
      </div>

      <!-- Gemini AI Deep Analysis -->
      <div class="space-y-3">
        <h3 class="text-lg font-bold text-slate-800 flex items-center">
          <i class="fa-solid fa-brain text-purple-500 mr-2"></i> Gemini AI 심층 맞춤 분석
        </h3>
        <div id="aiAnalysis" class="bg-purple-50/50 p-5 rounded-2xl text-slate-800 text-sm sm:text-base leading-relaxed whitespace-pre-line border border-purple-100">
        </div>
      </div>

      <!-- Reset Button -->
      <div class="text-center pt-4">
        <button type="button" id="resetBtn" class="px-6 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold rounded-xl text-sm transition-colors">
          <i class="fa-solid fa-rotate-right mr-1.5"></i> 다시 테스트하기
        </button>
      </div>
    </section>

  </div>

  <!-- JavaScript Module -->
  <script type="module">
    import { GoogleGenAI } from '@google/genai';

    // 질문 데이터 (PDF 기반 문항 구성)[cite: 1]
    const questions = [
      // E vs I
      { id: 'q1', type: 'EI', optionA: '처음보는 아이들과도 쉽게 이야기하거나 친해지는 편이다.', optionB: '친한 사람이나 친구가 없는 모임에 가면 매우 불편한 편이다.', valA: 'E', valB: 'I' },
      { id: 'q2', type: 'EI', optionA: '모르는 사람들이 많이 모여있는 곳에서도 비교적 활발하게 행동하는 편이다.', optionB: '친구를 쉽게 사귀는 편이 아니며 친한 몇 명의 친구들과 아주 친하게 지낸다.', valA: 'E', valB: 'I' },
      { id: 'q3', type: 'EI', optionA: '여기 저기 친구나 아는 사람이 많다 (학원, 교회, 학교 등).', optionB: '평소에 침착하고 조용하다는 말을 자주 듣는다.', valA: 'E', valB: 'I' },
      { id: 'q4', type: 'EI', optionA: '모임에서 다른 사람보다 말을 많이 하는 편이며 적극적으로 행동한다.', optionB: '혼자 놀거나 조용히 책을 읽는 모습이 자주 있다.', valA: 'E', valB: 'I' },
      { id: 'q5', type: 'EI', optionA: '슬프거나 기쁜 일이 생기면 즉시 부모님에게 이야기하는 편이다.', optionB: '먼저 여러 번 생각해 다음에 행동하는 편이다.', valA: 'E', valB: 'I' },
      { id: 'q6', type: 'EI', optionA: '활발하고 적극적이라는 말을 많이 듣는 편이다.', optionB: '부끄러움을 쉽게 타는 편이다.', valA: 'E', valB: 'I' },
      { id: 'q7', type: 'EI', optionA: '시간이 걸리는 일, 놀이는 싫증을 빨리 내고 새로운 놀이/활동을 원한다.', optionB: '자신의 의견이나 감정을 표현하는데 재빠르지 않은 편이다.', valA: 'E', valB: 'I' },
      { id: 'q8', type: 'EI', optionA: '혼자 조용히 있거나 책을 읽는 것보다 사람들과 어울리는 게 좋다.', optionB: '누가 물어보았을 때에야 대답하는 편이다.', valA: 'E', valB: 'I' },
      { id: 'q9', type: 'EI', optionA: '새로운 유행이 시작되면 다른 친구들보다 먼저 시도해보는 편이다.', optionB: '낯선 곳에 혼자 심부름 가는 건 좀 불편하다.', valA: 'E', valB: 'I' },

      // S vs N
      { id: 'q10', type: 'SN', optionA: "'이불처럼 폭신한 구름'이란 꾸밈어보다 '흰구름'처럼 단순한 말이 더 좋다.", optionB: '상상 속의 이야기를 잘 만들어 내는 편이다.', valA: 'S', valB: 'N' },
      { id: 'q11', type: 'SN', optionA: '주변 사람들의 얼굴, 키나 다른 특징들을 잘 기억한다. 꾸준하고 참을성 있다는 말을 듣는다.', optionB: '종종 물건을 잃어버리거나 어디에 두었는지 기억을 못할 때가 있다. 독특하고 창의적이란 말을 듣는다.', valA: 'S', valB: 'N' },
      { id: 'q12', type: 'SN', optionA: '공부할 때 세세하고 자세한 내용을 잘 암기하는 편이다.', optionB: '다른 아이들이 생각하지도 않은 엉뚱한 행동이나 상상을 할 때가 종종 있다.', valA: 'S', valB: 'N' },
      { id: 'q13', type: 'SN', optionA: '손으로 직접 만지거나 하나하나 조작하는 활동을 좋아한다.', optionB: '질문을 많이 하는 편이다.', valA: 'S', valB: 'N' },
      { id: 'q14', type: 'SN', optionA: '꼼꼼하다는 말을 자주 듣는 편이다.', optionB: '가끔 내 상상 속에서만 있는 친구를 만들기도 한다.', valA: 'S', valB: 'N' },
      { id: 'q15', type: 'SN', optionA: '새로운 일이나 활동보다는 늘상 하는 일이 편안하다.', optionB: '신기한 것에 호기심이 많다.', valA: 'S', valB: 'N' },
      { id: 'q16', type: 'SN', optionA: "'그게 정말이야?'라는 식의 질문을 많이 한다.", optionB: '장난감을 분해하고 살펴보는 것을 좋아한다.', valA: 'S', valB: 'N' },
      { id: 'q17', type: 'SN', optionA: '새로운 방법을 써보기보다는 친구들이 하는 대로 따라서 하는 게 더 편하다.', optionB: "'하고 싶다. 되고 싶다' 꿈이 여러 가지로 많다.", valA: 'S', valB: 'N' },

      // T vs F
      { id: 'q18', type: 'TF', optionA: "'왜'라는 질문을 자주 하는 편이다.", optionB: '부모님이나 선생님의 말을 잘 듣는 편이다.', valA: 'T', valB: 'F' },
      { id: 'q19', type: 'TF', optionA: '끝까지 해내는 의지와 끈기가 강한 편이다.', optionB: '기뻐하고 슬픈 감정이 풍부하고 인정이 많다는 말을 듣는다.', valA: 'T', valB: 'F' },
      { id: 'q20', type: 'TF', optionA: '궁금한 게 있으면 꼬치꼬치 따져서 궁금증을 풀고 싶어 한다.', optionB: '정이 많고 순하다는 말을 자주 듣는다.', valA: 'T', valB: 'F' },
      { id: 'q21', type: 'TF', optionA: '야단을 맞거나 벌을 받아도 눈물을 잘 보이지 않는 편이다.', optionB: '주위에 불쌍한 사람이나 친구가 있으면 마음이 아프고 도와주고 싶다. 벌을 받으면 눈물부터 나온다.', valA: 'T', valB: 'F' },
      { id: 'q22', type: 'TF', optionA: '한번 마음 먹은 일은 꾸준히 밀어나가 꼭 이뤄내는 편이다.', optionB: '다른 친구들이나 어른들이 내 행동을 어떻게 생각할지 신경이 쓰인다.', valA: 'T', valB: 'F' },
      { id: 'q23', type: 'TF', optionA: '주변 어른들이 귀엽다고 쓰다듬어 주면 어색하다.', optionB: '매를 맞으면 쉽게 잘못했다고 하는 편이다.', valA: 'T', valB: 'F' },
      { id: 'q24', type: 'TF', optionA: '성적이 올랐거나 잘했을 때 직접적인 칭찬을 받는 게 좋다.', optionB: '친구들 사이에서 성격이 부드럽다, 싹싹하다, 순하다고들 한다.', valA: 'T', valB: 'F' },
      { id: 'q25', type: 'TF', optionA: '부모님, 친구들에게 논리적이고 구체적인 설명으로 설득하는 편이다.', optionB: '음식, 장난감, 옷을 선택할 때 쉽게 결정을 내리지 못한다.', valA: 'T', valB: 'F' },

      // J vs P
      { id: 'q26', type: 'JP', optionA: '대체로 공부나 할일을 미리 해놓고 노는 편이다.', optionB: '계획보다는 어떤 일이 닥치면 그때그때 처리하는 편이다.', valA: 'J', valB: 'P' },
      { id: 'q27', type: 'JP', optionA: '시험보기 전에 미리 여유있게 공부계획을 짜 놓고 실천한다.', optionB: '숙제를 미루다가 마지막 순간에 해서 시간에 쫓길 때가 종종 있다.', valA: 'J', valB: 'P' },
      { id: 'q28', type: 'JP', optionA: '미리 하는 게 편하고 마지막 순간에 쫓기면서 일하는 걸 싫어한다.', optionB: '방이 어수선하게 지저분해도 크게 신경쓰이지 않고 관심대상에 바로 집중한다.', valA: 'J', valB: 'P' },
      { id: 'q29', type: 'JP', optionA: '계획에 따라 규칙적인 생활을 하는 편이다.', optionB: '주변일에 호기심이 많고 새로운 일이 생겨도 잘 적응한다.', valA: 'J', valB: 'P' },
      { id: 'q30', type: 'JP', optionA: '목표가 뚜렷하고 자신의 의견을 분명히 표현하는 편이다.', optionB: '남의 지시에 따르기보다는 자신의 마음에 따라 행동하는 것이 좋다.', valA: 'J', valB: 'P' },
      { id: 'q31', type: 'JP', optionA: '계획에 없는 일이 생기면 짜증이 나고 힘이 든다.', optionB: '공책이나 책가방을 미리 챙기고 준비하는 편은 아니다.', valA: 'J', valB: 'P' },
      { id: 'q32', type: 'JP', optionA: '학교나 친구들 모임에서 책임있는 일을 맡고 싶다.', optionB: '자신의 생각, 의견을 크게 주장하지는 않는다.', valA: 'J', valB: 'P' },
      { id: 'q33', type: 'JP', optionA: '예정에 없던 일로 계획을 바꾸게 되면 힘들어 한다.', optionB: '신발이나 옷이 떨어져도 무관심한 편이다.', valA: 'J', valB: 'P' },
      { id: 'q34', type: 'JP', optionA: '깨끗이 정돈된 상태를 좋아한다.', optionB: '자기 것을 친구나 형제들한테 비교적 잘 나누어주는 편이다.', valA: 'J', valB: 'P' }
    ];

    // PDF 기본 요약 데이터[cite: 1]
    const baseSummaryData = {
      'ISTJ': '성실하고 책임감이 강하며 정리정돈을 잘합니다. 절약과 준비정신이 철저하며 외유내강의 성품을 지녔습니다.',
      'ISFJ': '온순하고 성실하며 인내심이 뛰어납니다. 준비물을 잘 챙기고 타인에게 도움이 되고자 하는 마음이 큽니다.',
      'ISTP': '손재주가 있고 개방적이며 진취적입니다. 평소에는 조용하지만 상황 발생 시 성급하게 일을 해결하기도 합니다.',
      'ISFP': '마음이 너그럽고 순하며 예술적 감각이 있습니다. 권위적인 분위기를 불편해하지만 친절합니다.',
      'ESTP': '명랑하고 활발하며 승부근성이 강합니다. 임기응변에 뛰어나고 호탕하며 대중 앞에서 강한 모습을 보입니다.',
      'ESFP': '항상 즐겁고 붙임성이 좋으며 적응력이 뛰어납니다. 쾌활하고 감정이 풍부하여 주변의 활력소 역할을 합니다.',
      'ESTJ': '모범적이고 책임감이 강하며 정직합니다. 합리적이고 공정한 것을 선호하며 리더십을 잘 발휘합니다.',
      'ESFJ': '친절하고 표정과 표현력이 뛰어나 주변 사람을 잘 배려합니다. 교실 정돈이나 그룹 활동에서 활약합니다.',
      'INFJ': '조용하고 침착하며 또래에 비해 성숙한 생각을 지녔습니다. 깊은 따뜻함과 완벽성을 추구하는 성향이 있습니다.',
      'INTJ': '독립적이고 독창적이며 효율성을 중시합니다. 논리적이고 이유가 타당해야 설득되며 고집과 소신이 강합니다.',
      'INFP': '온화하고 순수하며 자신의 가치를 중시합니다. 민감하고 사려 깊으며 가치 있는 일에 열정을 다합니다.',
      'INTP': '호기심이 많고 논리적이며 과학적 영역에 관심이 높습니다. 주관이 강하고 지적 호기심이 풍부합니다.',
      'ENFP': '상상력과 표현력이 풍부하고 기발합니다. 사람을 좋아하며 분위기를 유쾌하게 만드는 매력이 있습니다.',
      'ENFJ': '온순하고 착하며 책임감이 강합니다. 주변 사람을 잘 끌어안고 예능적 분야나 리더 역할에 뛰어납니다.',
      'ENTP': '활발하고 독창적이며 다방면에 관심이 많습니다. 상상력과 자기 논리가 뛰어나며 창의적 해결사입니다.',
      'ENTJ': '통솔력이 뛰어나며 목표가 뚜렷합니다. 논리적이고 계획한 일을 의지력 있게 추진해내는 리더 유형입니다.'
    };

    // 화면 로드 시 질문 카드 생성
    window.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('questionsContainer');
      let currentSection = '';

      questions.forEach((q, idx) => {
        let sectionTitle = '';
        if (q.type === 'EI' && currentSection !== 'EI') {
          currentSection = 'EI';
          sectionTitle = '<h3 class="text-xl font-bold text-indigo-700 mt-8 mb-4 border-b border-indigo-200 pb-2">Part 1. 외향성(E) vs 내향성(I)</h3>';
        } else if (q.type === 'SN' && currentSection !== 'SN') {
          currentSection = 'SN';
          sectionTitle = '<h3 class="text-xl font-bold text-indigo-700 mt-8 mb-4 border-b border-indigo-200 pb-2">Part 2. 감각(S) vs 직관(N)</h3>';
        } else if (q.type === 'TF' && currentSection !== 'TF') {
          currentSection = 'TF';
          sectionTitle = '<h3 class="text-xl font-bold text-indigo-700 mt-8 mb-4 border-b border-indigo-200 pb-2">Part 3. 사고(T) vs 감정(F)</h3>';
        } else if (q.type === 'JP' && currentSection !== 'JP') {
          currentSection = 'JP';
          sectionTitle = '<h3 class="text-xl font-bold text-indigo-700 mt-8 mb-4 border-b border-indigo-200 pb-2">Part 4. 판단(J) vs 인식(P)</h3>';
        }

        const card = document.createElement('div');
        card.className = "bg-white p-5 rounded-2xl shadow-sm border border-slate-200 hover:border-indigo-300 transition-colors";
        card.innerHTML = `
          ${sectionTitle}
          <p class="text-xs font-bold text-indigo-500 mb-3">Q${idx + 1}.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <label class="relative flex items-start p-3 rounded-xl border border-slate-200 hover:bg-indigo-50/50 cursor-pointer transition-colors group">
              <input type="radio" name="${q.id}" value="${q.valA}" class="mt-1 text-indigo-600 focus:ring-indigo-500">
              <span class="ml-3 text-sm text-slate-700 group-hover:text-indigo-900 leading-relaxed">${q.optionA}</span>
            </label>
            <label class="relative flex items-start p-3 rounded-xl border border-slate-200 hover:bg-indigo-50/50 cursor-pointer transition-colors group">
              <input type="radio" name="${q.id}" value="${q.valB}" class="mt-1 text-indigo-600 focus:ring-indigo-500">
              <span class="ml-3 text-sm text-slate-700 group-hover:text-indigo-900 leading-relaxed">${q.optionB}</span>
            </label>
          </div>
        `;
        container.appendChild(card);
      });

      document.getElementById('analyzeBtn').addEventListener('click', calculateAndAnalyze);
      document.getElementById('resetBtn').addEventListener('click', resetForm);
    });

    // 지연 대기 함수 (재시도용)
    const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));

    // 계산 및 Gemini API 호출 (503 대응 재시도 및 폴백 로직 추가)
    async function calculateAndAnalyze() {
      const scores = { E: 0, I: 0, S: 0, N: 0, T: 0, F: 0, J: 0, P: 0 };
      let unanswered = false;

      for (const q of questions) {
        const selected = document.querySelector(`input[name="${q.id}"]:checked`);
        if (!selected) {
          unanswered = true;
          break;
        }
        scores[selected.value]++;
      }

      if (unanswered) {
        alert('아직 답변하지 않은 질문이 있습니다. 모든 문항을 선택해 주세요!');
        return;
      }

      // MBTI 계산
      const mbti = 
        (scores.E >= scores.I ? 'E' : 'I') +
        (scores.S >= scores.N ? 'S' : 'N') +
        (scores.T >= scores.F ? 'T' : 'F') +
        (scores.J >= scores.P ? 'J' : 'P');

      // UI 업데이트
      document.getElementById('analyzeBtn').disabled = true;
      document.getElementById('loadingSpinner').classList.remove('hidden');
      document.getElementById('resultSection').classList.add('hidden');
      document.getElementById('spinnerText').innerText = "Gemini AI가 당신의 MBTI와 성격을 심층 분석하고 있습니다...";

      document.getElementById('mbtiBadge').innerText = mbti;
      document.getElementById('basicTraits').innerText = baseSummaryData[mbti] || '장점에 집중하고 자신감을 가지세요!';

      const apiKey = document.getElementById('apiKeyInput').value.trim();

      if (!apiKey) {
        document.getElementById('aiAnalysis').innerText = "💡 Gemini API 키가 입력되지 않았습니다.\n상단의 API 키 입력란에 키를 입력하시면 AI의 맞춤형 심층 분석과 조언을 함께 받아보실 수 있습니다.";
        finishLoading();
        return;
      }

      const promptText = `사용자의 MBTI 결과는 ${mbti}입니다. (점수 분포: E=${scores.E}, I=${scores.I}, S=${scores.S}, N=${scores.N}, T=${scores.T}, F=${scores.F}, J=${scores.J}, P=${scores.P})
다음 지침에 따라 친절하고 따뜻하게 성격을 심층 분석해 주세요:
1. ${mbti} 유형의 핵심 성격적 강점 (3~4가지)
2. 잠재적 단점 및 이를 보완할 수 있는 실천적 조언
3. 대인관계 및 대화 스타일 팁
4. 용기를 주는 따뜻한 총평 한 문장`;

      // 503 방지를 위해 여러 모델 순차 사용 (Primary -> Secondary Fallback)
      const modelsToTry = ['gemini-3.8-flash', 'gemini-2.0-flash'];
      let lastError = null;
      let successText = null;

      const ai = new GoogleGenAI({ apiKey: apiKey });

      for (const modelName of modelsToTry) {
        // 모델당 최대 2번 재시도 (Exponential Backoff)
        for (let attempt = 1; attempt <= 2; attempt++) {
          try {
            if (attempt > 1 || modelName !== modelsToTry[0]) {
              document.getElementById('spinnerText').innerText = `서버 트래픽으로 재시도 중입니다... (${modelName})`;
            }

            const response = await ai.models.generateContent({
              model: modelName,
              contents: promptText,
            });

            if (response.text) {
              successText = response.text;
              break;
            }
          } catch (error) {
            console.warn(`Attempt ${attempt} with ${modelName} failed:`, error);
            lastError = error;
            // 503이나 429 오류 시 1.5초 대기 후 재시도
            if (attempt < 2) await delay(1500);
          }
        }
        if (successText) break; // 성공 시 반복문 탈출
      }

      if (successText) {
        document.getElementById('aiAnalysis').innerText = successText;
      } else {
        document.getElementById('aiAnalysis').innerText = `⚠️ 구글 Gemini AI 서버에 일시적인 트래픽 폭주(503 과부하)가 발생하고 있습니다.\n잠시 후(10~30초 뒤) [결과 분석하기] 버튼을 다시 눌러주세요.\n\n(상세 메시지: ${lastError?.message || 'Server Unavailable'})`;
      }

      finishLoading();
    }

    function finishLoading() {
      document.getElementById('loadingSpinner').classList.add('hidden');
      document.getElementById('analyzeBtn').disabled = false;
      const resultSec = document.getElementById('resultSection');
      resultSec.classList.remove('hidden');
      resultSec.scrollIntoView({ behavior: 'smooth' });
    }

    function resetForm() {
      document.getElementById('mbtiForm').reset();
      document.getElementById('resultSection').classList.add('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  </script>
</body>
</html>
